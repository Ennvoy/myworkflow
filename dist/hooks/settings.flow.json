{
  "_comment": "Flow hook 註冊片段。安裝檔會把 {{CLAUDE_HOME}} 換成實際路徑（用正斜線，Node 在 Windows 也吃）後 merge 進 ~/.claude/settings.json。node 須在 PATH（Claude Code 必有）。",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "TaskUpdate",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{CLAUDE_HOME}}/hooks/flow-verify-gate.mjs\""
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{CLAUDE_HOME}}/hooks/flow-commit-gate.mjs\""
          }
        ]
      },
      {
        "_comment": "C-5：auto-gate 擴到 Write|Edit——自駕下攔相依 manifest 編輯（改 package.json 加套件繞過命令列 install 偵測）。",
        "matcher": "Write|Edit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{CLAUDE_HOME}}/hooks/flow-auto-gate.mjs\""
          }
        ]
      },
      {
        "matcher": "Write|Edit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{CLAUDE_HOME}}/hooks/flow-spec-gate.mjs\""
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{CLAUDE_HOME}}/hooks/flow-design-base-hint.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{CLAUDE_HOME}}/hooks/flow-stall-monitor.mjs\""
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{CLAUDE_HOME}}/hooks/flow-size-check.mjs\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{CLAUDE_HOME}}/hooks/flow-stop-gate.mjs\""
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{CLAUDE_HOME}}/hooks/flow-precompact.mjs\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{CLAUDE_HOME}}/hooks/flow-session-start.mjs\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{CLAUDE_HOME}}/hooks/flow-size-check.mjs\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{CLAUDE_HOME}}/hooks/flow-size-check.mjs\""
          }
        ]
      }
    ]
  }
}
