{
  "_comment": "Flow hook 註冊片段。安裝檔會把 {{CLAUDE_HOME}} 換成實際路徑（用正斜線，Node 在 Windows 也吃）後 merge 進 ~/.claude/settings.json。node 須在 PATH（Claude Code 必有）。",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "TaskUpdate",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{CLAUDE_HOME}}/hooks/flow-verify-gate.mjs\""
          }
        ]
      },
      {
        "_comment": "C-3① 安檢門四合一：commit-gate/auto-gate/spec-gate 合併成 flow-dispatch 一次 node 冷啟跑完（省每工具呼叫 spawn 3 支的冷啟稅）。各道邏輯仍在原檔、可單跑；dispatch 接線完整性由 session-start 對賬。",
        "matcher": "Write|Edit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{CLAUDE_HOME}}/hooks/flow-dispatch.mjs\""
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{CLAUDE_HOME}}/hooks/flow-design-base-hint.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{CLAUDE_HOME}}/hooks/flow-stall-monitor.mjs\""
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{CLAUDE_HOME}}/hooks/flow-size-check.mjs\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{CLAUDE_HOME}}/hooks/flow-stop-gate.mjs\""
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{CLAUDE_HOME}}/hooks/flow-precompact.mjs\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{CLAUDE_HOME}}/hooks/flow-session-start.mjs\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{CLAUDE_HOME}}/hooks/flow-size-check.mjs\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{CLAUDE_HOME}}/hooks/flow-size-check.mjs\""
          }
        ]
      }
    ]
  }
}
